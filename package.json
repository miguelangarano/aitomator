{
  "name": "aitomator",
  "version": "0.1.1",
  "description": "A tiny, agent-friendly TypeScript workflow daemon",
  "keywords": [
    "automation",
    "workflow",
    "daemon",
    "typescript",
    "bun",
    "sqlite",
    "ai-agent"
  ],
  "type": "module",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "aitomator": "src/cli/index.ts"
  },
  "files": [
    "src",
    "skill",
    "assets",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "RELEASING.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miguelangarano/aitomator.git"
  },
  "homepage": "https://github.com/miguelangarano/aitomator#readme",
  "bugs": {
    "url": "https://github.com/miguelangarano/aitomator/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "start": "bun run src/cli/index.ts",
    "dev": "bun --watch run src/cli/index.ts start",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "build": "bun build src/cli/index.ts src/runner/main.ts --target=bun --outdir=dist",
    "prepublishOnly": "bun test && bun run typecheck && bun run build"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "license": "MIT"
}
